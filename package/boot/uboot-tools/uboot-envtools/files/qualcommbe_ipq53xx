[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)

case "$board" in
gl.inet,gl-be6500)
	ubootenv_add_mtd "0:appsblenv" "0x0" "0x40000" "0x40000"
	;;
tplink,archer-be550-v2|\
tplink,archer-be9300-v2)
	# stock 30_uboot-envtools (qcom,ipq5332-ap-mi01.6, NAND): offset 0,
	# env 0x40000, sector = erase block, 2 sectors
	ubootenv_add_mtd "0:appsblenv" "0x0" "0x40000" "0x20000" "2"
	;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config

exit 0
