#!/bin/sh
# Archer BE550 v2: copy the IPQ5332 (2.4 GHz) Q6 firmware from the stock
# TP-Link firmware that is still installed in the other NAND slot.
#
# The stock Q6 images carry a TP-Link certificate chain. If this SoC only
# accepts TP-Link-signed Q6 firmware, the upstream ath12k-firmware-ipq5332
# files fail to load and the 2.4 GHz radio stays down. This script copies
# the unit's own stock files into /lib/firmware (overlay) so ath12k uses
# them instead. Nothing is written to the stock slot.
#
# usage: be550v2-stock-wifi-fw [install|remove]

. /lib/functions.sh

DEST=/lib/firmware/ath12k/IPQ5332/hw1.0
MNT=/tmp/stock-rootfs
SRC_DIR=lib/firmware/IPQ5332/WIFI_FW

die() { echo "$*" >&2; cleanup; exit 1; }

cleanup() {
	grep -q " $MNT " /proc/mounts && umount "$MNT"
	[ -n "$BLOCK" ] && ubiblock -r "$BLOCK" 2>/dev/null
	[ -n "$UBI_ATTACHED" ] && ubidetach -d "$UBI_ATTACHED" 2>/dev/null
}

[ "$(board_name)" = "tplink,archer-be550-v2" ] || die "not an Archer BE550 v2"

case "${1:-install}" in
remove)
	for f in "$DEST"/q6_fw0.* "$DEST"/q6_fw1.* "$DEST"/iu_fw.*; do
		[ -e "/rom$f" ] && cp -a "/rom$f" "$f" || rm -f "$f"
	done
	echo "Restored the firmware shipped with OpenWrt. Reboot to use it."
	exit 0
	;;
install) ;;
*) die "usage: $0 [install|remove]" ;;
esac

# the slot we did not boot from
other=rootfs
grep -q 'ubi.mtd=rootfs_1' /proc/cmdline || other=rootfs_1

mtd=$(find_mtd_index "$other")
[ -n "$mtd" ] || die "no $other partition"

ubi=$(ubiattach -m "$mtd" 2>/dev/null | sed -n 's/.*device number \([0-9]*\).*/\1/p')
[ -n "$ubi" ] || die "cannot attach $other (already attached, or not UBI)"
UBI_ATTACHED=$ubi

vol=$(ubinfo -d "$ubi" -N ubi_rootfs 2>/dev/null | sed -n 's/^Volume ID: *\([0-9]*\).*/\1/p')
[ -n "$vol" ] || die "$other does not hold the stock firmware (no ubi_rootfs volume)"

ubiblock -c "/dev/ubi${ubi}_${vol}" || die "cannot create ubiblock"
BLOCK="/dev/ubi${ubi}_${vol}"

mkdir -p "$MNT"
mount -t squashfs -o ro "/dev/ubiblock${ubi}_${vol}" "$MNT" || die "cannot mount stock rootfs"

[ -f "$MNT/$SRC_DIR/q6_fw0.mdt" ] || die "stock Q6 firmware not found"
cat "$MNT/$SRC_DIR/fw_version.txt" 2>/dev/null

mkdir -p "$DEST"
for f in "$MNT/$SRC_DIR"/q6_fw0.* "$MNT/$SRC_DIR"/q6_fw1.* "$MNT/$SRC_DIR"/iu_fw.*; do
	case "$f" in *.flist) continue ;; esac
	cp "$f" "$DEST/" || die "copy of $f failed"
done

cleanup
echo "Stock IPQ5332 Q6 firmware installed in $DEST. Reboot to use it."
echo "Undo with: $0 remove"
