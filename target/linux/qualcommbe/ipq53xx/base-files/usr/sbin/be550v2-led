#!/bin/sh
# Archer BE550 v2: drive the front LED through the LED controller MCU.
#
# Protocol taken from the stock /usr/bin/led_combination (1.3.3):
#  - MCU is an I2C slave at 0x50 on the QUP at 0x78b7000.
#  - RGB effect = one 12-byte write:
#      [0] mode  [1..3] colour 1 (R G B)  [4..6] colour 2 (R G B)
#      [7..9] zero  [10..11] CRC16-XMODEM over bytes 0..9, big endian
#  - status events = one 1-byte write. Bytes from the stock default-config
#    (led_combination section, decrypted from etc/partition_config).
# 0x18, 0x20 and 0x30..0x32 belong to the MCU firmware update path (version
# query, Ymodem) and are refused.
#
# usage: be550v2-led on [rrggbb] | off | mode <name> [rrggbb [rrggbb]] |
#        status <name> | event <byte> | bus

. /lib/functions.sh

ADDR=0x50
MODES="none:0xc0 breathing:0xc1 flash:0xc2 rainbow:0xc3 spectrum:0xc4 \
comet:0xc5 wave:0xc6 fire:0xc7 ripple:0xc8 mountain:0xc9 night:0xca \
loop:0xcb static:0xcc"
# stock event name -> command byte
STATUS="off:160 reboot:161 internet-up:162 internet-down:163 \
internet-wifi-down:164 wifi-down:165 upgrade:166 reset:167 wps:168"

be550v2_board() {
	case "$(board_name)" in
	tplink,archer-be550-v2|tplink,archer-be9300-v2) return 0 ;;
	esac
	return 1
}

die() { echo "$*" >&2; exit 1; }

find_bus() {
	local d
	for d in /sys/bus/i2c/devices/i2c-*; do
		case "$(readlink -f "$d/of_node" 2>/dev/null)" in
		*/i2c@78b7000) echo "${d##*-}"; return 0 ;;
		esac
	done
	return 1
}

crc16() {
	local crc=0 b i
	for b in "$@"; do
		crc=$(( crc ^ (b << 8) ))
		i=0
		while [ $i -lt 8 ]; do
			if [ $(( crc & 0x8000 )) -ne 0 ]; then
				crc=$(( ((crc << 1) ^ 0x1021) & 0xffff ))
			else
				crc=$(( (crc << 1) & 0xffff ))
			fi
			i=$(( i + 1 ))
		done
	done
	echo $crc
}

rgb() {
	echo "$1" | grep -qE '^[0-9a-fA-F]{6}$' || die "bad colour '$1' (want rrggbb)"
	echo "0x$(echo "$1" | cut -c1-2) 0x$(echo "$1" | cut -c3-4) 0x$(echo "$1" | cut -c5-6)"
}

send() {
	local bus n
	bus=$(find_bus) || die "LED I2C bus not found"
	for n in 1 2 3; do
		be550v2-i2cw "$bus" "$ADDR" "$@" && return 0
		sleep 1
	done
	die "LED controller did not answer"
}

effect() {
	local mode="$1" c1 c2 crc code=""
	local m
	for m in $MODES; do
		[ "${m%%:*}" = "$mode" ] && code="${m##*:}"
	done
	[ -n "$code" ] || die "unknown mode '$mode'"
	c1=$(rgb "${2:-000000}") || exit 1
	c2=$(rgb "${3:-000000}") || exit 1
	crc=$(crc16 $code $c1 $c2 0 0 0)
	send $code $c1 $c2 0 0 0 $(( crc >> 8 )) $(( crc & 0xff ))
}

be550v2_board || die "not an Archer BE550 v2"

case "$1" in
on)	effect static "${2:-ffffff}" ;;
off)	effect none ;;
mode)	[ -n "$2" ] || die "usage: $0 mode <name> [rrggbb [rrggbb]]"
	effect "$2" "$3" "$4" ;;
status)
	v=""
	for m in $STATUS; do
		[ "${m%%:*}" = "$2" ] && v="${m##*:}"
	done
	[ -n "$v" ] || die "usage: $0 status <name>
names: $(echo $STATUS | sed 's/:[0-9]*//g')"
	send $v ;;
event)
	echo "$2" | grep -qE '^(0x[0-9a-fA-F]{1,2}|[0-9]{1,3})$' || die "usage: $0 event <byte>"
	v=$(( $2 ))
	[ $v -le 255 ] || die "byte out of range"
	case $v in
	24|32|48|49|50) die "refused: MCU firmware update command" ;;
	esac
	send $v ;;
bus)	find_bus || die "LED I2C bus not found" ;;
*)	die "usage: $0 on [rrggbb] | off | mode <name> [rrggbb [rrggbb]] | status <name> | event <byte> | bus
modes: $(echo $MODES | sed 's/:0x[0-9a-f]*//g')
status: $(echo $STATUS | sed 's/:[0-9]*//g')" ;;
esac
