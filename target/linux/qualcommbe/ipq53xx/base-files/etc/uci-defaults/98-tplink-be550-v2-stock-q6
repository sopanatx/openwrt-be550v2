#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# First boot after a web-UI install: the other NAND slot still holds the
# stock firmware. Keep a copy of its Wi-Fi firmware (IPQ5332 Q6 and
# QCN9274) in /etc/be550v2 so "be550v2-stock-wifi-fw install" still works
# after sysupgrade has overwritten that slot. The copy is not activated.
. /lib/functions.sh

case "$(board_name)" in tplink,archer-be550-v2|tplink,archer-be9300-v2) true ;; *) false ;; esac || exit 0

/usr/sbin/be550v2-stock-wifi-fw save >/dev/null 2>&1
exit 0
