. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

ipq53xx_setup_interfaces()
{
	local board="$1"
	local lan_mac wan_mac

	case "$board" in
	ubnt,u7-pro-xgs)
		ucidef_set_interface_lan "lan"
		;;
	gl.inet,gl-be6500)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
		wan_mac=$(mtd_get_mac_binary "0:art" 0xa)
		if [ -n "$wan_mac" ]; then
			lan_mac=$(macaddr_add "$wan_mac" 1)
			ucidef_set_network_device_mac "wan" "$wan_mac"
			ucidef_set_network_device_mac "lan" "$lan_mac"
			ucidef_set_interface_macaddr "wan" "$wan_mac"
			ucidef_set_interface_macaddr "lan" "$lan_mac"
			ucidef_set_label_macaddr "$wan_mac"
		fi
		;;
	gl.inet,gl-be9300)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
		;;
	tplink,archer-be550-v2|\
	tplink,archer-be9300-v2)
		if [ "$board" = "tplink,archer-be9300-v2" ]; then
			# unmanaged switch behind one interface
			ucidef_set_interfaces_lan_wan "lan" "wan"
		else
			ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "wan"
		fi
		# factory MAC: 6 raw bytes in tp_data/default-mac, mounted
		# read-only in preinit (lib/preinit/09_mount_tp_data)
		lan_mac=$(get_mac_binary "/tmp/tp_data/default-mac" 0)
		if [ -n "$lan_mac" ]; then
			wan_mac=$(macaddr_add "$lan_mac" 1)
			ucidef_set_network_device_mac "lan" "$lan_mac"
			ucidef_set_network_device_mac "wan" "$wan_mac"
			ucidef_set_interface_macaddr "lan" "$lan_mac"
			ucidef_set_interface_macaddr "wan" "$wan_mac"
			ucidef_set_label_macaddr "$lan_mac"
		fi
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

board_config_update
board=$(board_name)
ipq53xx_setup_interfaces $board
board_config_flush

exit 0
