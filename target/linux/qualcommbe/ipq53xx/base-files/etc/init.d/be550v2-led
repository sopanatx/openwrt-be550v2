#!/bin/sh /etc/rc.common
# Archer BE550 v2: front LED status, with the stock event codes.

START=99
STOP=10

is_board() {
	. /lib/functions.sh
	[ "$(board_name)" = "tplink,archer-be550-v2" ]
}

boot() {
	is_board || return 0
	. /lib/functions/network.sh
	if network_flush_cache && network_is_up wan; then
		/usr/sbin/be550v2-led status internet-up 2>/dev/null
	else
		/usr/sbin/be550v2-led status internet-down 2>/dev/null
	fi
	return 0
}

shutdown() {
	is_board || return 0
	/usr/sbin/be550v2-led status reboot 2>/dev/null
	return 0
}
