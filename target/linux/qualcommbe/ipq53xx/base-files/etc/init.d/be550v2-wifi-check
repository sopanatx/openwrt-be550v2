#!/bin/sh /etc/rc.common
# Archer BE550 v2: Wi-Fi firmware fallback, see /usr/sbin/be550v2-wifi-check

START=99

boot() {
	. /lib/functions.sh
	case "$(board_name)" in tplink,archer-be550-v2|tplink,archer-be9300-v2) true ;; *) false ;; esac || return 0
	/usr/sbin/be550v2-wifi-check </dev/null >/dev/null 2>&1 &
}
