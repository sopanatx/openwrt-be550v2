# Archer BE550 v2: follow the WAN state on the front LED.

. /lib/functions.sh

case "$(board_name)" in tplink,archer-be550-v2|tplink,archer-be9300-v2) true ;; *) false ;; esac || exit 0
[ "$INTERFACE" = "wan" ] || exit 0

case "$ACTION" in
ifup)	/usr/sbin/be550v2-led status internet-up 2>/dev/null ;;
ifdown)	/usr/sbin/be550v2-led status internet-down 2>/dev/null ;;
esac
